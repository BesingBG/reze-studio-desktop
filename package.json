{
  "name": "reze-studio-desktop",
  "version": "0.1.5",
  "private": false,
  "description": "Reze Studio 桌面客户端",
  "main": "electron/main.mjs",
  "author": {
    "name": "Reze Studio"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dist": "node scripts/dist.mjs",
    "make-icon": "node scripts/make-icon.mjs"
  },
  "build": {
    "appId": "dev.reze.rezestudio.desktop",
    "productName": "Reze Studio",
    "afterPack": "scripts/after-pack.cjs",
    "files": [
      "electron/**",
      "package.json",
      "config.json"
    ],
    "extraResources": [
      {
        "from": "dist-resources/reze-studio",
        "to": "reze-studio"
      },
      {
        "from": "resources",
        "to": "."
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.graphics-design",
      "icon": "build/icon.icns",
      "artifactName": "RezeStudio-${version}.${ext}"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "artifactName": "RezeStudio-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Reze Studio"
    },
    "directories": {
      "output": "dist"
    }
  },
  "license": "GPL-3.0",
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "jimp": "^1.6.1",
    "png-to-ico": "^3.0.2",
    "png2icons": "^2.0.1"
  }
}
